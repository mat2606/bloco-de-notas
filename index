      // favicon do share
      if(note.favicon){
        let link = document.querySelector('link[rel="icon"]');
        if(!link){
          link = document.createElement("link");
          link.rel = "icon";
          document.head.appendChild(link);
        }
        link.href = note.favicon;
      }else{
        applyFaviconFromLocal();
      }

      // sticker do share
      if(note.sticker){
        el("shareStickerImg").src = note.sticker;
        el("shareSticker").style.display = "block";
      }else{
        el("shareSticker").style.display = "none";
      }

      el("shareName").textContent = note.name || "Nota";
      el("shareInfo").textContent = `Atualizado: ${formatDate(note.updatedAt || note.createdAt)}`;
      el("shareRawText").textContent = note.text || "";
      el("shareSub").textContent = "Compartilhado do Bloco Inteligente Web • Somente leitura";

      const sections = parseTextToSections(note.text || "");
      renderBlocksInto(el("shareBlocks"), sections);
    }

    async function render(){
      setSaveModeTag();
      updateExtrasPreview();

      const q = getQuery();

      if(q.mode === "share" && q.id){
        setPanels("share");
        await renderShare(q.id);
        return;
      }

      await renderNotesList();

      if(q.mode === "view" && q.id){
        setPanels("view");

        if(q.id === "preview"){
          return;
        }

        await renderView(q.id);
      }else{
        setPanels("home");
      }
    }

    /***********************
