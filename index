    function pickImageAsBase64(callback){
      const input = document.createElement("input");
      input.type = "file";
      input.accept = "image/*";

      input.onchange = () => {
        const file = input.files?.[0];
        if(!file) return;

        if(file.size > 600 * 1024){
          toast("Imagem muito grande (máx ~600KB)");
          return;
        }

        const reader = new FileReader();
        reader.onload = () => callback(reader.result || "");
        reader.readAsDataURL(file);
      };

      input.click();
    }

    /***********************
     *  PARSER INTELIGENTE
     ***********************/
    function normalizeLine(line){
      return (line || "").replace(/\t/g, " ").replace(/\s+/g, " ").trim();
    }

    function isTitleLike(line){
      if(!line) return false;
      const clean = line.trim();
      if(clean.length < 3) return false;

      if(clean === clean.toUpperCase() && clean.includes(":")) return true;
      if(clean === clean.toUpperCase() && clean.endsWith(":")) return true;
      if(clean === clean.toUpperCase() && /\(\s*\d+/.test(clean)) return true;

      return false;
    }

    function splitKeyValue(line){
      const m = line.match(/^(.{1,50}?)(?:\s*(?:⎯|—|-|:)\s*)(.+)$/);
      if(!m) return null;

      const key = normalizeLine(m[1]);
      const val = normalizeLine(m[2]);

      if(!key || !val) return null;
      return { key, val };
    }

    function parseTextToSections(text){
      const raw = (text || "").trim();
      if(!raw) return [];

      const lines = raw.split(/\r?\n/).map(l=>l.replace(/\u00A0/g," "));

      let sections = [];
      let current = { title:"Geral", kv:[], lines:[] };

      function pushCurrent(){
        if(current.kv.length || current.lines.length){
          sections.push(current);
        }
      }

      for(const original of lines){
        const line = normalizeLine(original);
        if(!line) continue;

        if(isTitleLike(line)){
          pushCurrent();
          current = { title: line.replace(/\s*:\s*$/,"").trim(), kv:[], lines:[] };
          continue;
        }

        if(/^•\s+/.test(line) || /^-\s+/.test(line)){
          current.lines.push(line.replace(/^•\s+|^-\s+/,"").trim());
          continue;
        }

        const kv = splitKeyValue(line);
        if(kv){
          current.kv.push(kv);
          continue;
        }

        current.lines.push(line);
      }

      pushCurrent();

      if(sections.length === 1 && sections[0].kv.length >= 10){
        const s = sections[0];
        const chunk = 8;
        const newSections = [];

        for(let i=0;i<s.kv.length;i+=chunk){
          newSections.push({
            title: i===0 ? "Dados" : "Dados (continuação)",
            kv: s.kv.slice(i, i+chunk),
            lines:[]
          });
        }

        if(s.lines.length){
          newSections.push({
            title:"Anotações",
            kv:[],
            lines:s.lines
          });
        }

        return newSections;
      }

      return sections;
    }

