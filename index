    async function getAllNotes(){
      if(!currentUser){
        return loadLocal();
      }

      const colRef = collection(db, "users", currentUser.uid, "notes");
      const q = query(colRef, orderBy("updatedAt", "desc"));
      const snap = await getDocs(q);

      const notes = [];
      snap.forEach(d=> notes.push(d.data()));
      return notes;
    }

    async function getPublicNoteById(id){
      const ref = doc(db, "publicNotes", id);
      const snap = await getDoc(ref);
      if(!snap.exists()) return null;
      return snap.data();
    }

    // ✅ CORRIGIDO: agora só cria 1 vez (sem update)
    async function savePublicNote(note){
      if(!currentUser) throw new Error("not_logged");

      const ref = doc(db, "publicNotes", note.id);

      // 1) checa se já existe
      const snap = await getDoc(ref);

      // 2) se já existe, NÃO tenta atualizar (regras bloqueiam update)
      if(snap.exists()){
        return;
      }

      // 3) se não existe, cria 1 vez (regras permitem create)
      await setDoc(ref, {
        id: note.id,
        name: note.name || "Sem título",
        text: note.text || "",
        createdAt: note.createdAt || nowISO(),
        updatedAt: nowISO(),
        favicon: loadBase64(LOCAL_FAVICON_KEY) || "",
        sticker: loadBase64(LOCAL_STICKER_KEY) || ""
      });
    }

    async function getNoteById(id){
      if(!currentUser){
        return loadLocal().find(n=>n.id === id) || null;
      }

      const ref = doc(db, "users", currentUser.uid, "notes", id);
      const snap = await getDoc(ref);
      if(!snap.exists()) return null;
      return snap.data();
    }

    async function upsertNote(note){
      if(!currentUser){
        const all = loadLocal();
        const idx = all.findIndex(n=>n.id === note.id);

        if(idx >= 0){
          all[idx] = {
            ...all[idx],
            ...note,
            createdAt: all[idx].createdAt || note.createdAt,
            updatedAt: nowISO()
          };
        }else{
          all.unshift(note);
        }

        saveLocal(all);
        return;
      }

      const ref = doc(db, "users", currentUser.uid, "notes", note.id);

      const existing = await getNoteById(note.id);
      const createdAt = existing?.createdAt || note.createdAt || nowISO();

      await setDoc(ref, { ...note, createdAt, updatedAt: nowISO() }, { merge:true });
    }

    async function deleteNoteById(id){
      if(!currentUser){
        saveLocal(loadLocal().filter(n=>n.id !== id));
        return;
      }
      await deleteDoc(doc(db, "users", currentUser.uid, "notes", id));
    }

    async function clearAllNotes(){
      if(!currentUser){
        saveLocal([]);
        return;
      }

      const all = await getAllNotes();
      for(const n of all){
        await deleteDoc(doc(db, "users", currentUser.uid, "notes", n.id));
      }
    }

