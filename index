      }

      const name = el("noteName").value.trim() || "Prévia";

      history.pushState({}, "", location.pathname + "?mode=view&id=preview");
      setPanels("view");

      el("viewName").textContent = name;
      el("viewInfo").textContent = "Pré-organização (não salva)";
      el("rawText").textContent = text;

      const sections = parseTextToSections(text || "");
      renderBlocksInto(el("blocks"), sections);

      toast("Prévia pronta");
    });

    el("btnExportHTML").addEventListener("click", ()=>{
      const name = el("noteName").value.trim() || "Sem título";
      const text = el("noteText").value.trim();

      if(!text){
        toast("Cole algum texto primeiro");
        return;
      }

      exportNoteAsHTML(name, text);
      toast("Exportado!");
    });

    el("btnPickFavicon").addEventListener("click", ()=>{
      pickImageAsBase64((base64)=>{
        if(!base64) return;
        saveBase64(LOCAL_FAVICON_KEY, base64);
        updateExtrasPreview();
        toast("Ícone do export salvo!");
      });
    });

    el("btnPickSticker").addEventListener("click", ()=>{
      pickImageAsBase64((base64)=>{
        if(!base64) return;
        saveBase64(LOCAL_STICKER_KEY, base64);
        updateExtrasPreview();
        toast("Emoji/sticker salvo!");
      });
    });

    el("btnClearExtras").addEventListener("click", ()=>{
      const ok = confirm("Remover o ícone e o sticker salvos?");
      if(!ok) return;

      localStorage.removeItem(LOCAL_FAVICON_KEY);
      localStorage.removeItem(LOCAL_STICKER_KEY);
      updateExtrasPreview();
      toast("Removido!");
    });

    // VIEW buttons
    el("btnCopy").addEventListener("click", async ()=>{
      const q = getQuery();
      if(!q.id) return;

      let text = "";
      if(q.id === "preview"){
        text = el("rawText").textContent || "";
      }else{
        const note = await getNoteById(q.id);
        text = note ? (note.text || "") : "";
      }

      try{
        await navigator.clipboard.writeText(text);
        toast("Copiado!");
      }catch(e){
        toast("Não deu permissão pra copiar");
      }
    });

    // ✅ COMPARTILHAR (agora sem erro na 2ª vez)
    el("btnShare").addEventListener("click", async ()=>{
      const q = getQuery();
      if(!q.id || q.id === "preview"){
        toast("Abra uma nota salva para compartilhar");
        return;
      }

      if(!currentUser){
        toast("Para compartilhar por link, precisa estar logado no Google");
        return;
      }

      const note = await getNoteById(q.id);
      if(!note){
        toast("Nota não encontrada");
        return;
      }

      try{
        await savePublicNote(note);

        // sempre abre o share (mesmo se já existia)
        goShare(note.id);

        toast("Link pronto!");
      }catch(e){
        console.log(e);
        toast("Erro ao compartilhar");
      }
    });

    el("btnEdit").addEventListener("click", async ()=>{
      const q = getQuery();
      if(!q.id || q.id === "preview"){
        toast("Voltou pro editor");
        goHome();
        return;
      }

      const note = await getNoteById(q.id);
      if(!note) return toast("Nota não encontrada");

      editingNoteId = note.id || "";
      el("noteName").value = note.name || "";
      el("noteText").value = note.text || "";
      toast("Carregado no editor (modo edição)");
      goHome();
      el("noteText").focus();
    });

    el("btnDelete").addEventListener("click", async ()=>{
      const q = getQuery();
      if(!q.id || q.id === "preview"){
        toast("Nada pra apagar");
        goHome();
        return;
      }

      const note = await getNoteById(q.id);
      if(!note) return toast("Nota não encontrada");

      const ok = confirm(`Apagar a nota "${note.name}"?`);
      if(!ok) return;

      await deleteNoteById(q.id);
      toast("Nota apagada");
      editingNoteId = "";
      goHome();
      await renderNotesList();
    });

    // SHARE buttons
    el("btnShareHome").addEventListener("click", ()=>{
      goHome();
    });

    el("btnCopyLink").addEventListener("click", async ()=>{
      const url = location.href;
      try{
        await navigator.clipboard.writeText(url);
        toast("Link copiado!");
      }catch(e){
        toast("Não deu permissão pra copiar");
      }
    });

    el("btnDownloadShareHTML").addEventListener("click", async ()=>{
      const q = getQuery();
      if(!q.id) return;

      const note = await getPublicNoteById(q.id);
      if(!note){
        toast("Nota não encontrada");
        return;
      }

      exportNoteAsHTML(note.name || "nota", note.text || "", note.favicon || "", note.sticker || "");
      toast("Baixado!");
    });

    /***********************
     *  AUTH (Google)
     ***********************/
    async function doLogin(){
      try{
        await signInWithPopup(auth, provider);
        toast("Logado!");
      }catch(e){
        console.log(e);
        toast("Não deu pra logar");
      }
    }

    async function doLogout(){
      try{
        await signOut(auth);
        toast("Saiu da conta");
      }catch(e){
        toast("Erro ao sair");
      }
    }

    el("btnLogin").addEventListener("click", doLogin);
    el("btnLogout").addEventListener("click", doLogout);

    function updateUserUI(user){
      if(user){
        el("userName").textContent = user.displayName || "Usuário";
        el("userEmail").textContent = user.email || "Conta Google";
        el("btnLogin").style.display = "none";
        el("btnLogout").style.display = "inline-flex";

        if(user.photoURL){
          el("avatarImg").src = user.photoURL;
          el("avatarImg").style.display = "block";
        }else{
          el("avatarImg").style.display = "none";
        }
      }else{
        el("userName").textContent = "Não logado";
        el("userEmail").textContent = "Modo offline (LocalStorage)";
        el("btnLogin").style.display = "inline-flex";
        el("btnLogout").style.display = "none";
        el("avatarImg").style.display = "none";
      }
      setSaveModeTag();
    }

    onAuthStateChanged(auth, async (user)=>{
      currentUser = user || null;
      updateUserUI(currentUser);

      // ao trocar login, sai do modo edição
      editingNoteId = "";

      await render();
    });

    /***********************
     *  INIT
     ***********************/
    render();
  </script>
</body>
</html>
