    function renderBlocksInto(container, sections){
      container.innerHTML = "";

      if(!sections.length){
        container.innerHTML = `
          <div class="block" style="grid-column: 1 / -1;">
            <h3>⚠️ Vazio</h3>
            <div class="lines">
              <div class="line">Essa nota está vazia.</div>
            </div>
          </div>
        `;
        return;
      }

      for(const s of sections){
        const div = document.createElement("div");
        div.className = "block";

        const title = escapeHtml(s.title || "Bloco");
        let inner = `<h3>✨ ${title}</h3>`;

        if(s.kv && s.kv.length){
          inner += `<div class="kv">`;
          for(const pair of s.kv){
            inner += `
              <div class="row">
                <div class="k">${escapeHtml(pair.key)}</div>
                <div class="v">${escapeHtml(pair.val)}</div>
              </div>
            `;
          }
          inner += `</div>`;
        }

        if(s.lines && s.lines.length){
          inner += `<div class="lines" style="margin-top:${(s.kv && s.kv.length) ? "12px":"0"};">`;
          for(const l of s.lines){
            inner += `<div class="line">${escapeHtml(l)}</div>`;
          }
          inner += `</div>`;
        }

        div.innerHTML = inner;
        container.appendChild(div);
      }
    }

    async function renderView(id){
      const note = await getNoteById(id);
      if(!note){
        toast("Nota não encontrada");
        goHome();
        return;
      }

      el("viewName").textContent = note.name || "Nota";
      el("viewInfo").textContent = `Criado: ${formatDate(note.createdAt)} • Atualizado: ${formatDate(note.updatedAt)}`;
      el("rawText").textContent = note.text || "";

      const sections = parseTextToSections(note.text || "");
      renderBlocksInto(el("blocks"), sections);
    }

