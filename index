<!DOCTYPE html> 
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bloco Inteligente Web</title>

  <style>
    :root{
      --bg1:#030712;
      --bg2:#050f24;
      --glass:rgba(255,255,255,.06);
      --glass2:rgba(255,255,255,.09);
      --border:rgba(0,234,255,.25);
      --border2:rgba(255,255,255,.12);
      --neon:#00eaff;
      --pink:#ff4fd8;
      --purple:#8a5cff;
      --text:#eaf6ff;
      --muted:#9fb7c7;
      --shadow: 0 18px 60px rgba(0,0,0,.45);
      --radius: 22px;
      --radius2: 16px;
    }

    *{ box-sizing:border-box; }
    html,body{ height:100%; }
    body{
      margin:0;
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial;
      color:var(--text);
      background:
        radial-gradient(1200px 600px at 20% 10%, rgba(0,234,255,.14), transparent 60%),
        radial-gradient(1000px 700px at 85% 25%, rgba(255,79,216,.12), transparent 55%),
        radial-gradient(1200px 800px at 50% 90%, rgba(138,92,255,.12), transparent 55%),
        linear-gradient(180deg, var(--bg1), var(--bg2));
      overflow-x:hidden;
    }

    .sparkle{
      position:fixed;
      inset:0;
      pointer-events:none;
      opacity:.35;
      background-image:
        radial-gradient(2px 2px at 20% 30%, rgba(255,255,255,.7) 40%, transparent 60%),
        radial-gradient(2px 2px at 70% 15%, rgba(255,255,255,.6) 40%, transparent 60%),
        radial-gradient(2px 2px at 80% 70%, rgba(255,255,255,.5) 40%, transparent 60%),
        radial-gradient(1.6px 1.6px at 35% 80%, rgba(255,255,255,.6) 40%, transparent 60%),
        radial-gradient(1.6px 1.6px at 55% 55%, rgba(255,255,255,.55) 40%, transparent 60%),
        radial-gradient(1.6px 1.6px at 10% 70%, rgba(255,255,255,.55) 40%, transparent 60%);
      animation: twinkle 5s ease-in-out infinite;
    }
    @keyframes twinkle{
      0%,100%{ filter:blur(0px); transform:translateY(0px); opacity:.25; }
      50%{ filter:blur(.4px); transform:translateY(-2px); opacity:.45; }
    }

    .wrap{
      max-width:1100px;
      margin:0 auto;
      padding:26px 16px 40px;
    }

    header{
      display:flex;
      gap:14px;
      align-items:flex-start;
      justify-content:space-between;
      margin-bottom:18px;
    }

    .brand{
      display:flex;
      flex-direction:column;
      gap:6px;
    }

    .title{
      font-size:22px;
      letter-spacing:.4px;
      font-weight:900;
      line-height:1.1;
      background: linear-gradient(90deg, var(--neon), var(--pink), var(--purple));
      -webkit-background-clip:text;
      background-clip:text;
      color:transparent;
      text-shadow: 0 0 18px rgba(0,234,255,.08);
    }
    .subtitle{
      color:var(--muted);
      font-size:13px;
      line-height:1.3;
      max-width:650px;
    }

    .topActions{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      justify-content:flex-end;
    }

    .btn{
      border:1px solid var(--border2);
      background: rgba(255,255,255,.04);
      color:var(--text);
      padding:10px 12px;
      border-radius:14px;
      cursor:pointer;
      font-weight:700;
      transition:.18s ease;
      display:inline-flex;
      gap:10px;
      align-items:center;
      user-select:none;
      box-shadow: 0 10px 30px rgba(0,0,0,.2);
    }
    .btn:hover{ transform:translateY(-1px); border-color:var(--border); }
    .btn:active{ transform:translateY(0px) scale(.99); }
    .btnPrimary{
      border:1px solid rgba(0,234,255,.35);
      background: linear-gradient(135deg, rgba(0,234,255,.18), rgba(255,79,216,.12));
      box-shadow: 0 0 0 1px rgba(0,234,255,.06), 0 18px 60px rgba(0,0,0,.35);
    }
    .btnDanger{
      border:1px solid rgba(255,79,216,.35);
      background: rgba(255,79,216,.08);
    }

    .grid{
      display:grid;
      grid-template-columns: 1.1fr .9fr;
      gap:14px;
    }
    @media(max-width: 980px){
      .grid{ grid-template-columns: 1fr; }
      header{ flex-direction:column; align-items:flex-start; }
      .topActions{ width:100%; justify-content:flex-start; }
    }

    .card{
      background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03));
      border:1px solid rgba(255,255,255,.10);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow:hidden;
      position:relative;
    }

    .cardHeader{
      padding:14px 16px;
      border-bottom:1px solid rgba(255,255,255,.08);
      display:flex;
      gap:12px;
      align-items:center;
      justify-content:space-between;
      flex-wrap:wrap;
    }

    .cardHeader h2{
      margin:0;
      font-size:14px;
      letter-spacing:.4px;
      text-transform:uppercase;
      color:#d7f6ff;
      display:flex;
      gap:10px;
      align-items:center;
    }

    .tag{
      font-size:11px;
      color:rgba(255,255,255,.75);
      background: rgba(0,234,255,.10);
      border:1px solid rgba(0,234,255,.18);
      padding:4px 8px;
      border-radius:999px;
      font-weight:800;
      letter-spacing:.2px;
    }

    .cardBody{ padding:14px 16px 16px; }

    textarea{
      width:100%;
      min-height:320px;
      resize:vertical;
      border-radius: 18px;
      border:1px solid rgba(255,255,255,.12);
      background: rgba(0,0,0,.25);
      color:var(--text);
      padding:14px 14px;
      outline:none;
      font-size:14px;
      line-height:1.5;
      box-shadow: inset 0 0 0 1px rgba(0,234,255,.04);
    }
    textarea:focus{
      border-color: rgba(0,234,255,.35);
      box-shadow: 0 0 0 4px rgba(0,234,255,.08);
    }

    input[type="text"]{
      width:100%;
      border-radius: 14px;
      border:1px solid rgba(255,255,255,.12);
      background: rgba(0,0,0,.25);
      color:var(--text);
      padding:11px 12px;
      outline:none;
      font-size:14px;
    }
    input[type="text"]:focus{
      border-color: rgba(0,234,255,.35);
      box-shadow: 0 0 0 4px rgba(0,234,255,.08);
    }

    .hint{
      color:var(--muted);
      font-size:12px;
      margin-top:10px;
      line-height:1.35;
    }

    .list{
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    .noteItem{
      border:1px solid rgba(255,255,255,.10);
      background: rgba(0,0,0,.18);
      border-radius: 18px;
      padding:12px 12px;
      display:flex;
      gap:12px;
      justify-content:space-between;
      align-items:flex-start;
      transition:.18s ease;
    }
    .noteItem:hover{
      border-color: rgba(0,234,255,.25);
      transform: translateY(-1px);
    }

    .noteMeta{
      display:flex;
      flex-direction:column;
      gap:6px;
      min-width:0;
      flex:1;
    }
    .noteTitle{
      font-weight:900;
      font-size:14px;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }
    .noteDate{
      color:var(--muted);
      font-size:12px;
    }
    .notePreview{
      color:rgba(255,255,255,.72);
      font-size:12px;
      line-height:1.25;
      display:-webkit-box;
      -webkit-line-clamp:2;
      -webkit-box-orient:vertical;
      overflow:hidden;
      opacity:.9;
    }

    .noteActions{
      display:flex;
      flex-direction:column;
      gap:8px;
      align-items:flex-end;
    }

    .mini{
      padding:8px 10px;
      border-radius:12px;
      font-size:12px;
      font-weight:900;
    }

    .view{
      display:none;
      margin-top:12px;
    }

    .viewTop{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
      justify-content:space-between;
      padding:14px 16px;
      border-bottom:1px solid rgba(255,255,255,.08);
    }

    .viewTitle{
      display:flex;
      flex-direction:column;
      gap:6px;
      min-width:0;
      flex:1;
    }
    .viewTitle h1{
      margin:0;
      font-size:18px;
      font-weight:1000;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }
    .viewTitle .small{
      color:var(--muted);
      font-size:12px;
    }

    .blocks{
      padding:16px;
      display:grid;
      grid-template-columns: repeat(2, 1fr);
      gap:12px;
    }
    @media(max-width: 900px){
      .blocks{ grid-template-columns: 1fr; }
    }

    .block{
      border-radius: 22px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(0,0,0,.20);
      padding:14px 14px 12px;
      position:relative;
      overflow:hidden;
      box-shadow: 0 16px 50px rgba(0,0,0,.25);
    }
    .block::before{
      content:"";
      position:absolute;
      inset:-2px;
      background: radial-gradient(600px 260px at 30% 0%, rgba(0,234,255,.10), transparent 55%),
                  radial-gradient(600px 260px at 70% 0%, rgba(255,79,216,.08), transparent 55%);
      opacity:.7;
      pointer-events:none;
    }
    .block > *{ position:relative; z-index:1; }

    .block h3{
      margin:0 0 10px;
      font-size:13px;
      letter-spacing:.35px;
      text-transform:uppercase;
      color:#d7f6ff;
      display:flex;
      gap:10px;
      align-items:center;
    }

    .kv{
      display:flex;
      flex-direction:column;
      gap:8px;
    }
    .row{
      display:flex;
      gap:10px;
      align-items:flex-start;
      justify-content:space-between;
      border-bottom:1px dashed rgba(255,255,255,.12);
      padding-bottom:8px;
    }
    .row:last-child{ border-bottom:none; padding-bottom:0; }
    .k{
      color:rgba(255,255,255,.75);
      font-size:12px;
      font-weight:900;
      letter-spacing:.2px;
      min-width:140px;
      max-width:140px;
    }
    .v{
      flex:1;
      text-align:right;
      font-size:13px;
      color:rgba(255,255,255,.92);
      word-break:break-word;
    }

    .lines{
      display:flex;
      flex-direction:column;
      gap:8px;
    }
    .line{
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      padding:10px 12px;
      border-radius: 16px;
      font-size:13px;
      line-height:1.35;
      color:rgba(255,255,255,.92);
      word-break:break-word;
    }

    .rawBox{
      margin-top:14px;
      border-top:1px solid rgba(255,255,255,.08);
      padding:16px;
    }

    .rawBox details{
      border:1px solid rgba(255,255,255,.10);
      background: rgba(0,0,0,.22);
      border-radius: 18px;
      padding:12px 12px;
    }
    .rawBox summary{
      cursor:pointer;
      font-weight:900;
      color:#d7f6ff;
      letter-spacing:.2px;
    }
    pre{
      margin:10px 0 0;
      white-space:pre-wrap;
      word-break:break-word;
      color:rgba(255,255,255,.85);
      font-size:12.5px;
      line-height:1.5;
    }

    .toast{
      position:fixed;
      bottom:16px;
      left:50%;
      transform:translateX(-50%);
      background: rgba(0,0,0,.65);
      border:1px solid rgba(255,255,255,.12);
      color:rgba(255,255,255,.92);
      padding:10px 12px;
      border-radius: 14px;
      font-weight:800;
      font-size:13px;
      box-shadow: 0 20px 60px rgba(0,0,0,.45);
      opacity:0;
      pointer-events:none;
      transition:.2s ease;
      backdrop-filter: blur(10px);
      z-index:9999;
    }
    .toast.show{ opacity:1; transform:translateX(-50%) translateY(-2px); }

    .foot{
      margin-top:16px;
      color:rgba(255,255,255,.45);
      font-size:12px;
      text-align:center;
    }

    .pill{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:7px 10px;
      border-radius:999px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      font-size:12px;
      color:rgba(255,255,255,.78);
      font-weight:800;
      letter-spacing:.2px;
    }

    .userBox{
      display:flex;
      align-items:center;
      gap:10px;
      padding:8px 10px;
      border-radius: 16px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(0,0,0,.18);
      max-width: 520px;
      overflow:hidden;
    }
    .avatar{
      width:34px;
      height:34px;
      border-radius: 12px;
      background: rgba(255,255,255,.06);
      border:1px solid rgba(255,255,255,.12);
      overflow:hidden;
      flex:0 0 auto;
    }
    .avatar img{
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
    }
    .userMeta{
      display:flex;
      flex-direction:column;
      gap:2px;
      min-width:0;
      flex:1;
    }
    .userName{
      font-weight:1000;
      font-size:13px;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }
    .userEmail{
      font-size:12px;
      color:rgba(255,255,255,.65);
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }
    .smallBtn{
      padding:8px 10px;
      border-radius: 12px;
      font-size:12px;
      font-weight:1000;
    }

    .miniPreviewRow{
      display:flex;
      gap:10px;
      flex-wrap:wrap;
      align-items:center;
      margin-top: 10px;
    }
    .miniPreview{
      display:flex;
      align-items:center;
      gap:10px;
      padding:8px 10px;
      border-radius: 16px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(0,0,0,.18);
    }
    .miniPreview img{
      width:34px;
      height:34px;
      object-fit:cover;
      border-radius: 12px;
      border:1px solid rgba(255,255,255,.12);
      display:block;
    }
    .miniPreview span{
      font-size:12px;
      font-weight:900;
      color:rgba(255,255,255,.85);
    }

    /* SHARE MODE (somente leitura) */
    .shareTop{
      display:flex;
      gap:12px;
      flex-wrap:wrap;
      align-items:center;
      justify-content:space-between;
      padding:14px 16px;
      border-bottom:1px solid rgba(255,255,255,.08);
    }
    .shareTitle{
      display:flex;
      align-items:center;
      gap:12px;
      min-width:0;
      flex:1;
    }
    .shareTitle h1{
      margin:0;
      font-size:18px;
      font-weight:1000;
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }
    .shareSticker{
      width:44px;
      height:44px;
      border-radius: 18px;
      border:1px solid rgba(255,255,255,.12);
      background: rgba(0,0,0,.18);
      overflow:hidden;
      flex:0 0 auto;
      display:none;
      box-shadow: 0 16px 40px rgba(0,0,0,.25);
    }
    .shareSticker img{
      width:100%;
      height:100%;
      object-fit:contain;
      display:block;
      padding:6px;
    }
    .shareSub{
      padding:0 16px 14px;
      color:rgba(255,255,255,.70);
      font-size:12.5px;
      line-height:1.35;
    }
    .shareBox{
      display:none;
      margin-top:12px;
    }
    .shareLock{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:7px 10px;
      border-radius:999px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      font-size:12px;
      color:rgba(255,255,255,.78);
      font-weight:900;
      letter-spacing:.2px;
    }
  </style>
</head>

<body>
  <div class="sparkle"></div>

  <div class="wrap">
    <header id="mainHeader">
      <div class="brand">
        <div class="title">Bloco de Notas Inteligente (Web)</div>
        <div class="subtitle">
          Cole qualquer texto, clique em <b>Salvar & Abrir</b> e o site organiza automaticamente em blocos bonitos.
          <br>
          <span style="color:#bfefff">
            🔐 Se você entrar com Google, suas notas ficam salvas na nuvem (Firestore) e abrem em qualquer lugar.
          </span>
        </div>

        <div style="height:12px"></div>

        <div class="userBox" id="userBox">
          <div class="avatar" id="avatar">
            <img id="avatarImg" src="" alt="" style="display:none">
          </div>
          <div class="userMeta">
            <div class="userName" id="userName">Não logado</div>
            <div class="userEmail" id="userEmail">Modo offline (LocalStorage)</div>
          </div>
          <button class="btn smallBtn btnPrimary" id="btnLogin">Entrar</button>
          <button class="btn smallBtn" id="btnLogout" style="display:none;">Sair</button>
        </div>
      </div>

      <div class="topActions" id="topActions">
        <button class="btn" id="btnGoHome">🏠 Painel</button>
        <button class="btn" id="btnNew">✨ Nova Nota</button>
        <button class="btn btnDanger" id="btnClearAll">🗑️ Apagar Tudo</button>
      </div>
    </header>

    <!-- HOME / EDITOR -->
    <section id="home" class="grid">
      <div class="card">
        <div class="cardHeader">
          <h2>📝 Colar texto</h2>
          <span class="tag" id="saveModeTag">SALVANDO OFFLINE</span>
        </div>
        <div class="cardBody">
          <input type="text" id="noteName" placeholder="Nome da nota (ex: Ideias, Texto do dia...)" />
          <div style="height:10px"></div>
          <textarea id="noteText" placeholder="Cole aqui qualquer texto..."></textarea>

          <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:12px;">
            <button class="btn btnPrimary" id="btnSaveOpen">🚀 Salvar & Abrir</button>
            <button class="btn" id="btnJustSave">💾 Só Salvar</button>
            <button class="btn" id="btnFormatPreview">👁️ Pré-organizar</button>

            <button class="btn" id="btnExportHTML">📄 Exportar Nota (HTML)</button>

            <button class="btn" id="btnPickFavicon">🧿 Ícone do Export</button>
            <button class="btn" id="btnPickSticker">📎 Emoji/Sticker</button>
            <button class="btn btnDanger" id="btnClearExtras">🧼 Limpar Ícone/Sticker</button>
          </div>

          <div class="miniPreviewRow">
            <div class="miniPreview">
              <img id="faviconPreview" src="" alt="" style="display:none">
              <span id="faviconLabel">Ícone: (nenhum)</span>
            </div>
            <div class="miniPreview">
              <img id="stickerPreview" src="" alt="" style="display:none">
              <span id="stickerLabel">Sticker: (nenhum)</span>
            </div>
          </div>

          <div class="hint">
            Dica: o site tenta organizar automaticamente detectando linhas com “:” ou “—”, listas com “•” ou “-”
            e títulos em caixa alta.
          </div>
        </div>
      </div>

      <div class="card">
        <div class="cardHeader">
          <h2>📚 Notas salvas</h2>
          <span class="pill" id="countNotes">0 notas</span>
        </div>
        <div class="cardBody">
          <div class="list" id="notesList"></div>
          <div class="hint" style="margin-top:12px;">
            Offline = LocalStorage • Logado = Firestore (nuvem)
          </div>
        </div>
      </div>
    </section>

    <!-- VIEW (normal) -->
    <section id="view" class="card view">
      <div class="viewTop">
        <div class="viewTitle">
          <h1 id="viewName">Nota</h1>
          <div class="small" id="viewInfo">—</div>
        </div>

        <div style="display:flex; gap:10px; flex-wrap:wrap; justify-content:flex-end;">
          <button class="btn" id="btnCopy">📋 Copiar</button>
          <button class="btn" id="btnShare">📎 Compartilhar</button>
          <button class="btn" id="btnEdit">✏️ Editar</button>
          <button class="btn btnDanger" id="btnDelete">🗑️ Apagar</button>
        </div>
      </div>

      <div class="blocks" id="blocks"></div>

      <div class="rawBox">
        <details>
          <summary>Ver texto original (bruto)</summary>
          <pre id="rawText"></pre>
        </details>
      </div>
    </section>

    <!-- SHARE (somente leitura) -->
    <section id="share" class="card shareBox">
      <div class="shareTop">
        <div class="shareTitle">
          <div class="shareSticker" id="shareSticker">
            <img id="shareStickerImg" src="" alt="">
          </div>
          <div style="min-width:0;">
            <h1 id="shareName">Nota</h1>
            <div style="display:flex; gap:10px; flex-wrap:wrap; margin-top:6px;">
              <span class="shareLock">🔒 Somente leitura</span>
              <span class="pill" id="shareInfo">—</span>
            </div>
          </div>
        </div>

        <div style="display:flex; gap:10px; flex-wrap:wrap; justify-content:flex-end;">
          <button class="btn btnPrimary" id="btnCopyLink">📎 Copiar Link</button>
          <button class="btn" id="btnDownloadShareHTML">⬇️ Baixar HTML</button>
          <button class="btn" id="btnShareHome">🏠 Voltar</button>
        </div>
      </div>

      <div class="shareSub" id="shareSub">
        Esta página foi compartilhada do Bloco Inteligente Web.
      </div>

      <div class="blocks" id="shareBlocks"></div>

      <div class="rawBox">
        <details>
          <summary>Ver texto original (bruto)</summary>
          <pre id="shareRawText"></pre>
        </details>
      </div>
    </section>

    <div class="foot">
      1 arquivo só • Offline + Nuvem • Google Login • Firestore • Sem servidor próprio
    </div>
  </div>

  <div class="toast" id="toast">OK</div>

  <script type="module">
    /************************************************************
     * FIREBASE (Auth + Firestore) - 1 arquivo só (module)
     ************************************************************/
